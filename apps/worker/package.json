{
  "name": "@monara-sentinel/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "test": "echo \"no tests for worker\" && exit 0"
  },
  "dependencies": {
    "@monara-sentinel/config": "*",
    "@monara-sentinel/database": "*",
    "@monara-sentinel/domain": "*",
    "@monara-sentinel/intelligence": "*",
    "@monara-sentinel/ssrf": "*",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
