# Monara Sentinel Environment Variables

# Application
NODE_ENV=development
PORT=3002
API_URL=http://localhost:3002
WEB_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monara_sentinel?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/monara_sentinel?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT - must be at least 32 characters, generate with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption - 64 hex characters (32 bytes), generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Email (future)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# External APIs (future)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
WHOISXML_API_KEY=

# Monitoring (future)
SENTRY_DSN=
